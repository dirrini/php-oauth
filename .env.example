# Configurações do Banco de Dados (MySQL / PDO)
DB_HOST=db
DB_NAME=google_auth_db
DB_USER=auth_user
DB_PASSWORD=insira_uma_senha_segura_aqui
DB_ROOT_PASSWORD=insira_uma_senha_root_segura_aqui

# Credenciais da API do Google Console
GOOGLE_CLIENT_ID=seu_client_id_aqui.apps.googleusercontent.com
